# Set the REST backend base URL for normal development.
# VITE_API_URL=http://localhost:8000

# To use in-memory demo data instead, opt in explicitly. Never enable this in
# production: demo login accepts any password for its seeded accounts.
# VITE_API_MOCK=true

# Optional: comma-separated module keys (auth,emotions,posts,events,learning,
# tools,profile,misc,admin) that should keep using the mock even when
# VITE_API_URL is set above — useful while a module isn't implemented in the
# real API yet.
# VITE_API_MOCK_MODULES=posts,tools
